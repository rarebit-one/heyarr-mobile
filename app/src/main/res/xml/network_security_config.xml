<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext policy. The build-default heyarr node now speaks internal TLS
  (https://heyarr.br.thesim.family:7777, a valid Let's Encrypt cert), so QR login,
  playback and personal-state sync ride HTTPS by default — the base-config below
  forbids cleartext everywhere, which is exactly what we want for the
  `.br.thesim.family` service name.

  The ONE cleartext exception is the raw node IP 192.168.16.224. It is NOT the
  default path any more; it is the http FALLBACK a user can point at from the in-app
  Settings override (base-URL override) while internal TLS beds in — the same LAN
  host, reached by IP instead of name. Allowing cleartext to that single IP keeps
  that safety net working without opening cleartext to anything else. 10.0.2.2 and
  localhost stay for local dev (emulator host loopback). The debug source set
  overrides this file to allow cleartext everywhere so any LAN host typed into
  Settings works during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- http fallback for the Settings base-URL override: the same node by IP. -->
        <domain includeSubdomains="false">192.168.16.224</domain>
        <!-- Local dev: emulator host loopback + localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
